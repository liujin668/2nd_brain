      "title": "B12 内存标签（Memory Tagging）",
      "source_page": 429
    },
    {
      "type": "p",
      "text": "本章介绍内存标签机制，包含以下各节：",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.1 引言",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.2 消息扩展",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.3 标签一致性",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.4 读事务规则",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.5 写事务",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.6 无数据事务",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.7 原子事务",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.8 Stash事务",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.9 侦听请求",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.10 Home节点到从属节点的事务",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.11 错误响应",
      "source_page": 429
    },
    {
      "type": "bullet",
      "text": "B12.12 请求及允许的标签操作",
      "source_page": 429
    },
